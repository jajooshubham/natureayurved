# Custom/business SMTP server credentials used by app/routes/contact.ts
# Copy this file to .env and fill in your real values. Never commit .env.

SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false" for 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-smtp-password

# Optional: defaults to SMTP_USER if unset
SMTP_FROM=you@yourdomain.com
# Mailbox that should receive contact form enquiries; defaults to SMTP_USER if unset
CONTACT_TO_EMAIL=info@natureexpertayurvedic.com
